# Valores válidos dentro del docker-compose / Codespaces.
# Copiar a .env (el devcontainer lo hace solo al crearse).
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGO_DB=farmared
REDIS_URL=redis://redis:6379/0
# Zona horaria con la que se calcula "hoy" en consultas y servicios.
FARMARED_TZ=America/Argentina/Buenos_Aires
